{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/nasdaq-summary/(.*)",
      "destination": "https://api.nasdaq.com/api/quote/$1"
    },
    {
      "source": "/api/nasdaq-company/(.*)",
      "destination": "https://api.nasdaq.com/api/company/$1"
    },
    {
      "source": "/api/nasdaq-analyst/(.*)",
      "destination": "https://api.nasdaq.com/api/analyst/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
